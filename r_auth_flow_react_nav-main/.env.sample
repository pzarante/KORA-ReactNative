EXPO_PUBLIC_ROBLE_PROJECT_ID=#your_project_id_here
# Guest mode (signin-anonymous) only exists on the test server for now
EXPO_PUBLIC_ROBLE_API_URL=https://roble-api.test-openlab.uninorte.edu.co

# Registro: signup-direct = modo práctica (sin correo). Para correos reales usa "signup":
# Roble envía un código y la app muestra la pantalla "Verifica tu correo".
EXPO_PUBLIC_ROBLE_SIGNUP_ENDPOINT=signup-direct
